# ==============================================================================
# BASE DE DATOS (RAILWAY POSTGRESQL)
# ==============================================================================
# URL de conexión pública provista por Railway (ej: postgresql://postgres:clave@monorail.proxy.rlwy.net:12345/railway)
DATABASE_URL=postgresql://postgres:PASSWORD@monorail.proxy.rlwy.net:PUERTO/railway

# Parámetros alternativos de Railway si se definen por separado
DB_HOST=monorail.proxy.rlwy.net
DB_PORT=5432
DB_NAME=railway
DB_USER=postgres
DB_PASSWORD=PASSWORD