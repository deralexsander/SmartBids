# Copiar este archivo como .env y completar los valores.
# No subir el .env real ni archivos de credenciales a Git.

# ==============================================================================
# DJANGO — DESARROLLO LOCAL
# ==============================================================================
# Generar una clave propia para cada entorno.
DJANGO_SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_LOCAL
DJANGO_DEBUG=True
APP_VERSION=v1.0.0

# Listas separadas por comas, sin corchetes.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ==============================================================================
# POSTGRESQL — DESARROLLO LOCAL
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartbids
DB_USER=postgres
DB_PASSWORD=REEMPLAZAR

# ==============================================================================
# DATA WAREHOUSE
# ==============================================================================
# Comparte host, puerto, usuario y contraseña con la BD operacional.
DW_DB_NAME=smartbids_dw

# ==============================================================================
# POSTGRESQL — ALTERNATIVAS PARA RAILWAY
# ==============================================================================
# Mantener comentadas para desarrollo local.
# Las URLs tienen prioridad sobre todos los parámetros DB_*.
# Prioridad: DATABASE_PRIVATE_URL > DATABASE_URL > DATABASE_PUBLIC_URL.
#
# DATABASE_PRIVATE_URL=postgresql://USUARIO:CLAVE@HOST_PRIVADO:PUERTO/BASE
# DATABASE_URL=postgresql://USUARIO:CLAVE@HOST_PUBLICO:PUERTO/BASE
# DATABASE_PUBLIC_URL=postgresql://USUARIO:CLAVE@HOST_PUBLICO:PUERTO/BASE
#
# Usar el host y puerto reales indicados por Railway.
# En Railway configurar DJANGO_DEBUG=False y los dominios de producción.

# ==============================================================================
# FIREBASE — CONFIGURACIÓN WEB
# ==============================================================================
# Completar con la configuración del proyecto Firebase de desarrollo.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Opcional si no utilizan Analytics.
FIREBASE_MEASUREMENT_ID=

# ==============================================================================
# CORREO — GMAIL API
# ==============================================================================
EMAIL_HOST_USER=correo-de-pruebas@example.com

# JSON del token utilizado por el backend de Gmail.
# Completar únicamente en el .env real, con el formato que espera el backend.
GMAIL_TOKEN_JSON=

# ==============================================================================
# GOOGLE — CUENTA DE SERVICIO
# ==============================================================================
# JSON de credenciales de la cuenta de servicio.
# Completar únicamente en el .env real.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ==============================================================================
# ALMACENAMIENTO
# ==============================================================================
# Límite en GB. Completar según el entorno y el código que consume esta variable.
MAX_STORAGE_GB=